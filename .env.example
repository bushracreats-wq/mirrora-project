# MIRRÓRA AI Virtual Try-On Configuration
# Copy this file to .env and set your API credentials

# AI Virtual Try-On API Key (e.g., Fashn.ai or Replicate API key)
AI_TRYON_API_KEY=

# Provider options: fashn, replicate, or custom (Default: fashn)
AI_TRYON_PROVIDER=fashn

# Optional: Custom API Endpoint URL (if using a custom proxy or model host)
AI_TRYON_CUSTOM_URL=
